# YonelMa — environment variables
# Copy this file to `.env.local` and fill in the values.
# Lines marked OPTIONAL keep their feature cleanly disabled until set.

# ---- Supabase (REQUIRED) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Admin console (REQUIRED) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# ---- Stripe — online card payment (OPTIONAL) ----
# Test keys (sk_test_/pk_test_) for development, live keys for production.
# Get them at: Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: Stripe Dashboard → Developers → Webhooks → add endpoint
#   URL  https://your-domain/api/stripe/webhook
#   event checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Public site URL — used for Stripe redirects and password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Transactional emails via Resend (OPTIONAL) ----
RESEND_API_KEY=re_...
EMAIL_FROM=YonelMa <no-reply@your-domain.com>
