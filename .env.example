# YonelMa — environment variables
# Copy this file to `.env.local` and fill in the values.
# Lines marked OPTIONAL keep their feature cleanly disabled until set.

# ---- Supabase (REQUIRED) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Admin console (REQUIRED) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# ---- Phase 1 payment freeze (spec SF-002-EN §2) ----
# "No live customer payments during this phase." Online payment stays OFF
# even when the Stripe keys below are set. Set BOTH to "true" only once the
# founder and compliance have approved real collection.
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ---- Stripe — online card payment (OPTIONAL, gated by the flags above) ----
# Test keys (sk_test_/pk_test_) for development, live keys for production.
# Get them at: Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: Stripe Dashboard → Developers → Webhooks → add endpoint
#   URL  https://your-domain/api/stripe/webhook
#   event checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Public site URL — used for Stripe redirects and password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Transactional emails via Resend (OPTIONAL) ----
RESEND_API_KEY=re_...
EMAIL_FROM=YonelMa <no-reply@your-domain.com>

# ---- Notifications (SN-NAT-06) ----
# Channels to attempt, comma separated: email, sms, whatsapp.
# Phase 1 ships with email only; SMS and WhatsApp are declared in
# lib/notifications.ts and stay inert until a provider key is set.
NOTIFY_CHANNELS=email
# SMS_PROVIDER_KEY=
# WHATSAPP_PROVIDER_KEY=

# ---- Pickup codes ----
# Key used to encrypt pickup codes at rest. If unset, a key is derived from
# SUPABASE_SECRET_KEY. Changing either makes existing codes unreadable
# (they can be regenerated).
# PICKUP_CODE_SECRET=
